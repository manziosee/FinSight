{
  "title": "FinSight — Service Overview",
  "uid": "finsight-overview",
  "editable": true,
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate (RED)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_requests_total[5m])) by (job)", "legendFormat": "{{job}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job)", "legendFormat": "{{job}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))", "legendFormat": "{{job}}"}
      ]
    }
  ]
}
