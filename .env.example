# ---------------------------------------------------------------------------
# FinSight — local environment template. Copy to .env and adjust.
# NEVER commit a real .env. Secrets in prod come from AWS Secrets Manager.
# ---------------------------------------------------------------------------

# Global
FINSIGHT_ENV=local
FINSIGHT_LOG_LEVEL=INFO
FINSIGHT_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Postgres (a database per service, one server locally)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight_local_pw
# service DSNs
FINSIGHT_IDENTITY_DB_DSN=postgresql+asyncpg://finsight:finsight_local_pw@postgres:5432/identity
FINSIGHT_INGESTION_DB_DSN=postgresql+asyncpg://finsight:finsight_local_pw@postgres:5432/ingestion
FINSIGHT_NORMALIZATION_DB_DSN=postgresql+asyncpg://finsight:finsight_local_pw@postgres:5432/normalization
FINSIGHT_RECONCILIATION_DB_DSN=postgresql+asyncpg://finsight:finsight_local_pw@postgres:5432/reconciliation

# Kafka (Redpanda locally)
FINSIGHT_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Redis
FINSIGHT_REDIS_URL=redis://redis:6379/0

# Neo4j
FINSIGHT_NEO4J_URI=bolt://neo4j:7687
FINSIGHT_NEO4J_USER=neo4j
FINSIGHT_NEO4J_PASSWORD=finsight_local_pw

# Object storage (MinIO locally, S3 in prod)
FINSIGHT_S3_ENDPOINT_URL=http://minio:9000
FINSIGHT_S3_REGION=us-east-1
FINSIGHT_S3_ACCESS_KEY_ID=finsight
FINSIGHT_S3_SECRET_ACCESS_KEY=finsight_local_pw
FINSIGHT_S3_RAW_BUCKET=finsight-raw-data

# Identity / JWT (RS256). Local dev key pair is generated by scripts/bootstrap.sh
FINSIGHT_JWT_ISSUER=https://identity.finsight.local
FINSIGHT_JWT_AUDIENCE=finsight-api
FINSIGHT_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
# Local-only seed OAuth2 client (client_credentials grant)
FINSIGHT_SEED_CLIENT_ID=demo-client
FINSIGHT_SEED_CLIENT_SECRET=demo-secret

# Field-level encryption key (Fernet, 32 url-safe base64 bytes). Rotate in prod.
FINSIGHT_FIELD_ENCRYPTION_KEY=REPLACE_ME_WITH_scripts/bootstrap.sh_OUTPUT

# Bring-your-own-AI (intelligence-service). Anthropic is the default provider.
FINSIGHT_LLM_PROVIDER=anthropic
FINSIGHT_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
