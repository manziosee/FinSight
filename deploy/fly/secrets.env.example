# Copy to secrets.env (gitignored). provision.sh fills every generated value for you —
# the only thing you may want to set by hand is ANTHROPIC_API_KEY. Consumed by
# set-secrets.sh, which gives each Fly app only the secrets it needs.

# --- Tigris object storage (filled by provision.sh from `fly storage create`) ---
S3_ENDPOINT_URL=https://fly.storage.tigris.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=

# --- Self-hosted infra passwords (generated by provision.sh) ---
NEO4J_PASSWORD=
REDIS_PASSWORD=

# --- Bring-your-own-AI (optional; intelligence-service falls back to offline echo) ---
ANTHROPIC_API_KEY=

# --- Public issuer/audience for JWTs ---
JWT_ISSUER=https://finsight-api-gateway.fly.dev
JWT_AUDIENCE=finsight-api

# --- Optional bootstrap OAuth2 client (used by the smoke test) ---
# Leave SEED_CLIENT_ID empty to skip. In production identity-service refuses to start
# unless the secret is >= 32 random chars; provision.sh generates one.
# Changing the secret and redeploying rotates it for an already-seeded client.
SEED_CLIENT_ID=demo-client
SEED_CLIENT_SECRET=
