# Copy to secrets.env and fill in. Consumed by ./set-secrets.sh. NEVER commit secrets.env.

# --- Fly Postgres (from `fly postgres create` output; one cluster, 4 databases) ---
PG_HOST=finsight-pg.flycast
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=

# --- Upstash Kafka (console.upstash.com → Kafka → cluster details) ---
KAFKA_BOOTSTRAP=xxxxx.upstash.io:9092
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=

# --- Upstash Redis (from `fly redis status finsight-redis`) ---
REDIS_URL=rediss://default:PASSWORD@fly-finsight-redis.upstash.io:6379

# --- Neo4j Aura Free (console.neo4j.io) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Fly Tigris object storage (from `fly storage create` output) ---
S3_ENDPOINT_URL=https://fly.storage.tigris.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=

# --- Field-level encryption (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())") ---
FIELD_ENCRYPTION_KEY=

# --- Bring-your-own-AI (optional; falls back to offline echo) ---
ANTHROPIC_API_KEY=

# --- Public issuer/audience for JWTs ---
JWT_ISSUER=https://finsight-api-gateway.fly.dev
JWT_AUDIENCE=finsight-api

# --- Seed OAuth2 client for the smoke test (change for real use) ---
SEED_CLIENT_ID=demo-client
SEED_CLIENT_SECRET=change-me-please
