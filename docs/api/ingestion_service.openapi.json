{
  "openapi": "3.1.0",
  "info": {
    "title": "FinSight Ingestion Service",
    "description": "Accepts raw financial data of any shape and lands it in object storage.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness probe",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data/ingest": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest Json",
        "operationId": "ingest_json_v1_data_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestJson"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data/upload": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Upload",
        "operationId": "upload_v1_data_upload_post",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "spreadsheet",
              "title": "Source"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_v1_data_upload_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data/ingestions/{ingestion_id}": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "Get Ingestion",
        "description": "Get the status and normalization result for an ingestion owned by this tenant.",
        "operationId": "get_ingestion_v1_data_ingestions__ingestion_id__get",
        "parameters": [
          {
            "name": "ingestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ingestion Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_v1_data_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_data_upload_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestJson": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": "api",
            "examples": [
              "bank",
              "mobile_money",
              "erp"
            ]
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "minItems": 1,
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "IngestJson"
      },
      "IngestionAccepted": {
        "properties": {
          "ingestion_id": {
            "type": "string",
            "title": "Ingestion Id"
          },
          "status": {
            "type": "string",
            "const": "received",
            "title": "Status",
            "description": "The batch has been durably accepted."
          },
          "s3_uri": {
            "type": "string",
            "title": "S3 Uri"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url",
            "description": "Relative API path to poll for processing results."
          }
        },
        "type": "object",
        "required": [
          "ingestion_id",
          "status",
          "s3_uri",
          "status_url"
        ],
        "title": "IngestionAccepted"
      },
      "IngestionStatusResponse": {
        "properties": {
          "ingestion_id": {
            "type": "string",
            "title": "Ingestion Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "completed",
              "failed"
            ],
            "title": "Status",
            "description": "Current asynchronous processing state."
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Non-fatal parsing and normalization warnings."
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "ingestion_id",
          "status",
          "source",
          "record_count",
          "warnings",
          "created_at"
        ],
        "title": "IngestionStatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
