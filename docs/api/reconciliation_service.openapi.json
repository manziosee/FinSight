{
  "openapi": "3.1.0",
  "info": {
    "title": "FinSight Reconciliation Service",
    "description": "Matches payments to invoices (partial / split / over-under / FX), explains every leftover, and learns per-tenant from human review.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness probe",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/run": {
      "post": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Run",
        "operationId": "run_v1_reconciliation_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/{run_id}/matches": {
      "get": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Review Queue",
        "operationId": "review_queue_v1_reconciliation__run_id__matches_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "pending",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchOut"
                  },
                  "title": "Response Review Queue V1 Reconciliation  Run Id  Matches Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/matches/{match_id}/review": {
      "post": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Review Match",
        "operationId": "review_match_v1_reconciliation_matches__match_id__review_post",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Match Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/weights": {
      "get": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Get Weights",
        "operationId": "get_weights_v1_reconciliation_weights_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Weights V1 Reconciliation Weights Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/summary": {
      "get": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Summary",
        "description": "Aggregate evidence for the latest run \u2014 what intelligence-service narrates from.",
        "operationId": "summary_v1_reconciliation_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Summary V1 Reconciliation Summary Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reconciliation/{run_id}": {
      "get": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Get Run",
        "operationId": "get_run_v1_reconciliation__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/match": {
      "post": {
        "tags": [
          "reconciliation"
        ],
        "summary": "Match Pair",
        "operationId": "match_pair_v1_payments_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          },
          "invoice_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Invoice Ids"
          },
          "match_type": {
            "type": "string",
            "title": "Match Type"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "amount_applied_minor": {
            "type": "integer",
            "title": "Amount Applied Minor"
          },
          "residual_minor": {
            "type": "integer",
            "title": "Residual Minor"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "exceptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exceptions"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "payment_id",
          "invoice_ids",
          "match_type",
          "confidence",
          "amount_applied_minor",
          "residual_minor",
          "explanation",
          "status"
        ],
        "title": "MatchOut"
      },
      "PairRequest": {
        "properties": {
          "payment": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payment"
          },
          "invoice": {
            "additionalProperties": true,
            "type": "object",
            "title": "Invoice"
          }
        },
        "type": "object",
        "required": [
          "payment",
          "invoice"
        ],
        "title": "PairRequest"
      },
      "ReviewRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^(accept|reject|correct)$",
            "title": "Decision"
          },
          "corrected_invoice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected Invoice Id"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewRequest"
      },
      "RunRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "payment_invoice"
          },
          "ingestion_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingestion Id"
          }
        },
        "type": "object",
        "title": "RunRequest"
      },
      "RunResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "matched": {
            "type": "integer",
            "title": "Matched"
          },
          "unmatched": {
            "type": "integer",
            "title": "Unmatched"
          },
          "exceptions": {
            "type": "integer",
            "title": "Exceptions"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/MatchOut"
            },
            "type": "array",
            "title": "Matches"
          },
          "unmatched_items": {
            "items": {
              "$ref": "#/components/schemas/UnmatchedOut"
            },
            "type": "array",
            "title": "Unmatched Items"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "scope",
          "matched",
          "unmatched",
          "exceptions",
          "matches"
        ],
        "title": "RunResult"
      },
      "UnmatchedOut": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "side": {
            "type": "string",
            "title": "Side"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "record_id",
          "side",
          "reason"
        ],
        "title": "UnmatchedOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
